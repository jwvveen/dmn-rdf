dmn:requiredInput a owl:ObjectProperty ;
    rdfs:label "required input"@en ;
    schema:domainIncludes dmn:AuthorityRequirement ;
    schema:domainIncludes dmn:InformationRequirement ;
    rdfs:range dmn:InputData ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:requiredKnowledge a owl:ObjectProperty ;
    rdfs:label "required knowledge"@en ;
    rdfs:domain dmn:KnowledgeRequirement ;
    rdfs:range dmn:Invocable ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:requiresInformation a owl:ObjectProperty ;
    rdfs:label "requires information"@en ;
    schema:domainIncludes dmn:Decision ;
    schema:domainIncludes dmn:InputData ;
    rdfs:range dmn:InformationRequirement ;
    dmn:upperBound "*" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:return a owl:ObjectProperty ;
    rdfs:label "return"@en ;
    rdfs:domain dmn:For ;
    rdfs:range dmn:ChildExpression ;
    dmn:composite true ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:row a owl:ObjectProperty ;
    rdfs:label "row"@en ;
    rdfs:domain dmn:Relation ;
    rdfs:range dmn:List ;
    dmn:composite true ;
    dmn:upperBound "*" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:rule a owl:ObjectProperty ;
    rdfs:label "rule"@en ;
    rdfs:domain dmn:DecisionTable ;
    rdfs:range dmn:DecisionRule ;
    dmn:composite true ;
    dmn:upperBound "*" ;
    dmn:ordered true ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:ruleAnnotation a owl:ObjectProperty ;
    rdfs:label "rule annotation"@en ;
    rdfs:domain dmn:RuleAnnotation ;
    rdfs:range dmn:DecisionRule ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:ruleInput a owl:ObjectProperty ;
    rdfs:label "rule input"@en ;
    rdfs:domain dmn:UnaryTests ;
    rdfs:range dmn:DecisionRule ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:ruleOutput a owl:ObjectProperty ;
    rdfs:label "rule output"@en ;
    rdfs:domain dmn:LiteralExpression ;
    rdfs:range dmn:DecisionRule ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:satisfies a owl:ObjectProperty ;
    rdfs:label "satisfies"@en ;
    rdfs:domain dmn:Quantified ;
    rdfs:range dmn:ChildExpression ;
    dmn:composite true ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:sourceRef a owl:ObjectProperty ;
    rdfs:label "source ref"@en ;
    rdfs:domain dmn:Association ;
    rdfs:range dmn:DMNElement ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:supportedDecision a owl:ObjectProperty ;
    rdfs:label "supported decision"@en ;
    rdfs:domain dmn:Objective ;
    rdfs:range dmn:Decision ;
    dmn:upperBound "*" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:supportedObjective a owl:ObjectProperty ;
    rdfs:label "supported objective"@en ;
    rdfs:domain dmn:Decision ;
    rdfs:range dmn:Objective ;
    dmn:upperBound "*" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:targetRef a owl:ObjectProperty ;
    rdfs:label "target ref"@en ;
    rdfs:domain dmn:Association ;
    rdfs:range dmn:DMNElement ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:text a owl:DatatypeProperty ;
    rdfs:label "text"@en ;
    schema:domainIncludes dmn:LiteralExpression ;
    schema:domainIncludes dmn:RuleAnnotation ;
    schema:domainIncludes dmn:TextAnnotation ;
    schema:domainIncludes dmn:UnaryTests ;
    rdfs:range xsd:string ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:textFormat a owl:DatatypeProperty ;
    rdfs:label "text format"@en ;
    rdfs:domain dmn:TextAnnotation ;
    rdfs:range xsd:string ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:then a owl:ObjectProperty ;
    rdfs:label "then"@en ;
    rdfs:domain dmn:Conditional ;
    rdfs:range dmn:ChildExpression ;
    dmn:composite true ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:type a owl:DatatypeProperty ;
    rdfs:label "type"@en ;
    schema:domainIncludes dmn:Expression ;
    schema:domainIncludes dmn:InformationItem ;
    schema:domainIncludes dmn:KnowledgeSource ;
    schema:rangeIncludes dmn:ItemDefinition ;
    schema:rangeIncludes xsd:string ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:typeConstraint a owl:ObjectProperty ;
    rdfs:label "type constraint"@en ;
    rdfs:domain dmn:ItemDefinition ;
    rdfs:range dmn:UnaryTests ;
    dmn:composite true ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:typeLanguage a owl:DatatypeProperty ;
    rdfs:label "type language"@en ;
    schema:domainIncludes dmn:Definitions ;
    schema:domainIncludes dmn:ItemDefinition ;
    rdfs:range xsd:anyURI ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:typeRef a owl:DatatypeProperty ;
    rdfs:label "type ref"@en ;
    schema:domainIncludes dmn:Expression ;
    schema:domainIncludes dmn:InformationItem ;
    schema:domainIncludes dmn:ItemDefinition ;
    schema:domainIncludes dmn:OutputClause ;
    schema:domainIncludes dmn:TypedChildExpression ;
    rdfs:range xsd:string ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:usingProcess a owl:ObjectProperty ;
    rdfs:label "using process"@en ;
    rdfs:domain dmn:Decision ;
    rdfs:range bpmn:Process ;
    dmn:upperBound "*" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:usingTask a owl:ObjectProperty ;
    rdfs:label "using task"@en ;
    rdfs:domain dmn:Decision ;
    rdfs:range bpmn:Task ;
    dmn:upperBound "*" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:value a owl:ObjectProperty ;
    rdfs:label "value"@en ;
    schema:domainIncludes dmn:ChildExpression ;
    schema:domainIncludes dmn:ContextEntry ;
    schema:domainIncludes dmn:ExtensionAttribute ;
    schema:rangeIncludes dmn:Element ;
    schema:rangeIncludes dmn:Expression ;
    dmn:composite true ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:valueExpression a owl:ObjectProperty ;
    rdfs:label "value expression"@en ;
    rdfs:domain dmn:InformationItem ;
    rdfs:range dmn:Expression ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:valueRef a owl:ObjectProperty ;
    rdfs:label "value ref"@en ;
    rdfs:domain dmn:ExtensionAttribute ;
    rdfs:range dmn:Element ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .

dmn:variable a owl:ObjectProperty ;
    rdfs:label "variable"@en ;
    schema:domainIncludes dmn:ContextEntry ;
    schema:domainIncludes dmn:Decision ;
    schema:domainIncludes dmn:InputData ;
    schema:domainIncludes dmn:Invocable ;
    rdfs:range dmn:InformationItem ;
    dmn:composite true ;
    dmn:upperBound "1" ;
    rdfs:isDefinedBy <https://w3id.org/dmn> .
