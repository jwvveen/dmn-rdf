    owl:versionInfo "0.1.0" .

dmn:abstract a owl:AnnotationProperty ;
    rdfs:label "abstract"@en, "abstract"@nl ;
    rdfs:comment "True for metamodel classes that have no instances of their own (isAbstract in the XMI)."@en .

dmn:composite a owl:AnnotationProperty ;
    rdfs:label "composite"@en ;
    rdfs:comment "True for properties that own their values (aggregation composite in the XMI): the value lives inside its owner."@en .

dmn:upperBound a owl:AnnotationProperty ;
    rdfs:label "upper bound"@en ;
    rdfs:comment "Highest multiplicity of the property in the metamodel over all its owners: 1, or * for many."@en .

dmn:ordered a owl:AnnotationProperty ;
    rdfs:label "ordered"@en ;
    rdfs:comment "True for properties whose values are ordered in the metamodel (isOrdered in the XMI), such as the rules and entries of a decision table. Instance data records the order with dmn:position."@en .

dmn:position a owl:DatatypeProperty ;
    rdfs:label "position"@en, "positie"@nl ;
    rdfs:comment "1-based position of a value of an ordered property within its owner. Not part of the OMG metamodel: RDF has no order of its own, and in DMN order carries meaning (rules of a FIRST or RULE ORDER table, the entry that belongs to each clause)."@en ;
    rdfs:range xsd:positiveInteger .

dmn:xmlValue a owl:DatatypeProperty ;
    rdfs:label "XML value"@en ;
    rdfs:comment "The literal of an enumeration value exactly as it is written in DMN XML."@en .

