<https://w3id.org/dmn> a owl:Ontology ;
    dct:title "DMN 1.6 in RDF: core ontology"@en, "DMN 1.6 in RDF: kernontologie"@nl ;
    dct:description "Classes, properties and enumerations of the DMN 1.6 metamodel, generated from DMN16.xmi. Concept version for discussion; not a publication of the Object Management Group."@en ;
    dct:source <https://www.omg.org/spec/DMN/20240513/DMN16.xmi> ;
