# GENERATED by scripts/generate_matrix_ttl.py from sources/dmn-rules.json
# (DMN 1.6, formal/25-12-02, Table 2 and clause 8.2.11). Do not edit by hand.

<https://w3id.org/dmn/matrix> a owl:Ontology ;
    dct:title "DMN 1.6 in RDF: requirements matrix and hit policies"@en ;
    owl:imports <https://w3id.org/dmn> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.0" .

# The matrix vocabulary. Not part of the OMG metamodel.
dmn:RequirementRule a owl:Class ;
    rdfs:label "Requirement rule"@en, "Vereisteregel"@nl ;
    rdfs:comment "One cell of Table 2 of DMN 1.6 (clause 6.2.3): may an element of the requiring type require an element of the required type, and with which kind of requirement? Also records what DMN16.xsd and DMN16.xmi accept, which differs in four cells."@en .
dmn:requiredType a owl:ObjectProperty ; rdfs:label "required type"@en ; rdfs:domain dmn:RequirementRule ;
    rdfs:comment "Column From of Table 2: the element that is required."@en .
dmn:requiringType a owl:ObjectProperty ; rdfs:label "requiring type"@en ; rdfs:domain dmn:RequirementRule ;
    rdfs:comment "Column To (Required by) of Table 2: the element that owns the requirement."@en .
dmn:requirementType a owl:ObjectProperty ; rdfs:label "requirement type"@en ; rdfs:domain dmn:RequirementRule .
dmn:permitted a owl:DatatypeProperty ; rdfs:label "permitted"@en, "toegestaan"@nl ; rdfs:range xsd:boolean .
dmn:schemaAccepts a owl:ObjectProperty ; rdfs:label "schema accepts"@en ;
    rdfs:comment "A requirement class that DMN16.xsd and DMN16.xmi structurally accept for this pair."@en .
dmn:schemaMismatch a owl:ObjectProperty ; rdfs:label "schema mismatch"@en ;
    rdfs:comment "A requirement class that the schema accepts for this pair but the specification forbids."@en .
dmn:specCell a owl:DatatypeProperty ; rdfs:label "specification cell"@en .

# Hit policies and aggregations as data (clause 8.2.11).
dmn:letter a owl:DatatypeProperty ; rdfs:label "letter"@en ;
    rdfs:comment "The hit policy indicator printed in the table."@en .
dmn:singleHit a owl:DatatypeProperty ; rdfs:label "single hit"@en ; rdfs:range xsd:boolean .
dmn:ruleOrderMatters a owl:DatatypeProperty ; rdfs:label "rule order matters"@en ; rdfs:range xsd:boolean .
dmn:overlapAllowed a owl:DatatypeProperty ; rdfs:label "overlap allowed"@en ; rdfs:range xsd:boolean .
dmn:needsOutputValues a owl:DatatypeProperty ; rdfs:label "needs output values"@en ; rdfs:range xsd:boolean .
dmn:compoundOutputAllowed a owl:DatatypeProperty ; rdfs:label "compound output allowed"@en ; rdfs:range xsd:boolean .
dmn:aggregationAllowed a owl:DatatypeProperty ; rdfs:label "aggregation allowed"@en ; rdfs:range xsd:boolean .
dmn:operator a owl:DatatypeProperty ; rdfs:label "operator"@en .
dmn:feelFunction a owl:DatatypeProperty ; rdfs:label "FEEL function"@en .
dmn:verbatim a owl:DatatypeProperty ; rdfs:label "verbatim text"@en .
dmn:clause a owl:DatatypeProperty ; rdfs:label "clause"@en .
dmn:page a owl:DatatypeProperty ; rdfs:label "page"@en .


dmn:req-Decision-Decision a dmn:RequirementRule ;
    dmn:requiredType dmn:Decision ;
    dmn:requiringType dmn:Decision ;
    dmn:permitted true ;
    dmn:specCell "DMN 1.6 Table 2 (6.2.3), from Decision to Decision"@en ;
    dmn:page "26" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:requirementType dmn:InformationRequirement ;
    dmn:schemaAccepts dmn:InformationRequirement ;
    dmn:schemaAccepts dmn:AuthorityRequirement ;
    dmn:schemaMismatch dmn:AuthorityRequirement ;
    rdfs:comment "Table 22 (clause 6.3.15, printed page 48) describes requiredDecision as 'The instance of Decision that this AuthorityRequirement associates with its containing KnowledgeSource element' and requiredInput as 'The instance of InputData that this AuthorityRequirement associates with its containing KnowledgeSource element'; only requiredAuthority is described as associating with a 'containing KnowledgeSource, Decision or BusinessKnowledgeModel element'. Together with Table 2 and clause 6.2.2.3 b) ('drawn from Input Data and Decisions to Knowledge Sources') an AuthorityRequirement whose source is a Decision or Input Data may only be owned by a KnowledgeSource. The XSD (tAuthorityRequirement: choice of requiredDecision | requiredInput | requiredAuthority, owned by tDecision, tBusinessKnowledgeModel and tKnowledgeSource) and the XMI (AuthorityRequirement.requiredDecision/requiredInput [0..1], owners decision/bkm/knowledgeSource) do not restrict this, so this pair is schema-valid but forbidden by the specification text."@en .

