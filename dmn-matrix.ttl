dmn:HitPolicy-UNIQUE dmn:letter "U" ;
    dmn:singleHit true ;
    dmn:ruleOrderMatters false ;
    dmn:overlapAllowed false ;
    dmn:needsOutputValues false ;
    dmn:compoundOutputAllowed true ;
    dmn:aggregationAllowed false ;
    dmn:verbatim "Unique: no overlap is possible, and all rules are disjoint. Only a single rule can be matched. This is the default."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "74" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "8.2.11: 'Decision tables with the Unique hit policy SHALL NOT contain overlapping rules.' Crosstab tables are always Unique (8.2.11, 8.2.2)."@en .

dmn:HitPolicy-ANY dmn:letter "A" ;
    dmn:singleHit true ;
    dmn:ruleOrderMatters false ;
    dmn:overlapAllowed true ;
    dmn:needsOutputValues false ;
    dmn:compoundOutputAllowed true ;
    dmn:aggregationAllowed false ;
    dmn:verbatim "Any: there may be overlap, but all the matching rules show equal output entries for each output (ignoring rule annotations), so any match can be used."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "74" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "8.2.11.1: 'If the output entries are non-equal (ignoring rule annotations), the hit policy is incorrect, and the result is undefined.'"@en .

dmn:HitPolicy-PRIORITY dmn:letter "P" ;
    dmn:singleHit true ;
    dmn:ruleOrderMatters false ;
    dmn:overlapAllowed true ;
    dmn:needsOutputValues true ;
    dmn:compoundOutputAllowed true ;
    dmn:aggregationAllowed false ;
    dmn:verbatim "Priority: multiple rules can match, with different output entries. This policy returns the matching rule with the highest output priority. Output priorities are specified in the ordered list of output values, in decreasing order of priority. Note that priorities are independent from rule sequence."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "74" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Needs the ordered list of output values (8.2.6, 8.2.11.1). For compound outputs priority is decided over all outputs that have output values, left to right / top to bottom (8.2.11.1)."@en .

dmn:HitPolicy-FIRST dmn:letter "F" ;
    dmn:singleHit true ;
    dmn:ruleOrderMatters true ;
    dmn:overlapAllowed true ;
    dmn:needsOutputValues false ;
    dmn:compoundOutputAllowed true ;
    dmn:aggregationAllowed false ;
    dmn:verbatim "First: multiple (overlapping) rules can match, with different output entries. The first hit by rule order is returned (and evaluation can halt)."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "74" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Rule numbering required (8.2); rules SHALL be ordered (8.3.1)."@en .

dmn:HitPolicy-OUTPUT_ORDER dmn:letter "O" ;
    dmn:singleHit false ;
    dmn:ruleOrderMatters false ;
    dmn:overlapAllowed true ;
    dmn:needsOutputValues true ;
    dmn:compoundOutputAllowed true ;
    dmn:aggregationAllowed false ;
    dmn:verbatim "Output order: returns all hits in decreasing output priority order. Output priorities are specified in the ordered list of output values in decreasing order of priority."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "74" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "compoundOutputAllowed=true follows 8.2.11.1 (printed page 75), which lists Output order among the hit policies supported by compound-output tables and shows an example (Figure 8-19 'Output order with compound output'). Clause 10.3.2.10 (printed page 120) contradicts this twice: its list of hit policies for compound outputs omits Output order, and step 3a says 'If the hit policy is \"Output order\", the decision table SHALL be single output'."@en .

dmn:HitPolicy-RULE_ORDER dmn:letter "R" ;
    dmn:singleHit false ;
    dmn:ruleOrderMatters true ;
    dmn:overlapAllowed true ;
    dmn:needsOutputValues false ;
    dmn:compoundOutputAllowed true ;
    dmn:aggregationAllowed false ;
    dmn:verbatim "Rule order: returns all hits in rule order. Note: the meaning may depend on the sequence of the rules."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "74" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Rule numbering required (8.2); rules SHALL be ordered (8.3.1)."@en .

dmn:HitPolicy-COLLECT dmn:letter "C" ;
    dmn:singleHit false ;
    dmn:ruleOrderMatters false ;
    dmn:overlapAllowed true ;
    dmn:needsOutputValues false ;
    dmn:compoundOutputAllowed true ;
    dmn:aggregationAllowed true ;
    dmn:verbatim "Collect: returns either all hits in arbitrary order, or the result of applying a simple function to them."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "74" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "compoundOutputAllowed only without aggregation: 'Decision tables with compound outputs support only the following hit policies: ... Collect without operator, because the collect operator is undefined over multiple outputs' (8.2.11.1). The aggregation attribute applies only when hitPolicy is COLLECT (8.3.1, Table 32)."@en .

dmn:BuiltinAggregator-SUM dmn:operator "+" ;
    dmn:letter "C+" ;
    dmn:feelFunction "sum" ;
    dmn:verbatim "+ (sum): the result of the decision table is the sum of all the outputs."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "75" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> .

dmn:BuiltinAggregator-COUNT dmn:operator "#" ;
    dmn:letter "C#" ;
    dmn:feelFunction "count" ;
    dmn:verbatim "# (count): the result of the decision table is the number of outputs."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "75" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> .

dmn:BuiltinAggregator-MIN dmn:operator "<" ;
    dmn:letter "C<" ;
    dmn:feelFunction "minimum" ;
    dmn:verbatim "< (min): the result of the decision table is the smallest value of all the outputs."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "75" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> .

dmn:BuiltinAggregator-MAX dmn:operator ">" ;
    dmn:letter "C>" ;
    dmn:feelFunction "maximum" ;
    dmn:verbatim "> (max): the result of the decision table is the largest value of all the outputs."@en ;
    dmn:clause "8.2.11.1" ;
    dmn:page "75" ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> .
