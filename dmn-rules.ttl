@prefix dmn: <https://w3id.org/dmn#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dmnsh: <https://w3id.org/dmn/shapes#> .

# GENERATED by scripts/generate_matrix_ttl.py: the normative sentences of DMN 1.6
# that constrain models, each with the shape or check that tests it. Do not edit by
# hand; the coverage is kept in scripts/coverage.py.

<https://w3id.org/dmn/rules> a owl:Ontology ;
    dct:title "DMN 1.6 in RDF: catalogue of normative statements"@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.0" .

dmn:NormativeStatement a owl:Class ;
    rdfs:label "Normative statement"@en, "Normatieve uitspraak"@nl ;
    rdfs:comment "A sentence from the DMN specification that constrains models, quoted verbatim with its clause and page."@en .
dmn:checkedBy a owl:ObjectProperty ; rdfs:label "checked by"@en ; rdfs:domain dmn:NormativeStatement .
dmn:notCheckedBecause a owl:DatatypeProperty ; rdfs:label "not checked because"@en .
dmn:strength a owl:DatatypeProperty ; rdfs:label "strength"@en ;
    rdfs:comment "SHALL, SHOULD or MAY as written, or DEFINITION for a definition a check relies on."@en .
dmn:topic a owl:DatatypeProperty ; rdfs:label "topic"@en .
dmn:clause a owl:DatatypeProperty ; rdfs:label "clause"@en .
dmn:page a owl:DatatypeProperty ; rdfs:label "page"@en .
dmn:verbatim a owl:DatatypeProperty ; rdfs:label "verbatim text"@en .

dmn:statement-001 a dmn:NormativeStatement ;
    dmn:clause "6.1"@en ;
    dmn:page "21" ;
    dmn:topic "drg" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A DRG is a graph composed of elements connected by requirements and is self-contained in the sense that all the modeled requirements for any Decision in the DRG (its immediate sources of information, knowledge, and authority) are present in the same DRG."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:InformationRequirementShape ;
    dmn:checkedBy dmnsh:KnowledgeRequirementShape ;
    dmn:checkedBy dmnsh:AuthorityRequirementShape .

dmn:statement-002 a dmn:NormativeStatement ;
    dmn:clause "6.2.2.1"@en ;
    dmn:page "24" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Information Requirements may be drawn from Input Data elements to Decisions, and from Decisions to other Decisions."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Permissive wording; read with Table 2 as the exhaustive list."@en ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-003 a dmn:NormativeStatement ;
    dmn:clause "6.2.2.1"@en ;
    dmn:page "24" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The Information Requirements of a valid DRG form a directed acyclic graph."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:InformationAcyclicShape .

dmn:statement-004 a dmn:NormativeStatement ;
    dmn:clause "6.2.2.2"@en ;
    dmn:page "24" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Knowledge Requirements may be drawn from invocable elements (Business Knowledge Models or Decision Services) to Decisions and from invocable elements to Business Knowledge Models."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Permissive wording; read with Table 2 as the exhaustive list."@en ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-005 a dmn:NormativeStatement ;
    dmn:clause "6.2.2.2"@en ;
    dmn:page "24" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If e is a decision or a BKM in some DRD, and e contains a knowledge requirement on some invocable element b, then the logic of e must contain an invocation expression of b, including expressions for each of b's parameters."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-006 a dmn:NormativeStatement ;
    dmn:clause "6.2.2.3"@en ;
    dmn:page "25" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "They may be drawn from Knowledge Sources to Decisions, Business Knowledge Models, and other Knowledge Sources, where they represent the dependence of the DRD element on the knowledge source."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "'They' = Authority Requirements, use a). Permissive wording; read with Table 2."@en ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-007 a dmn:NormativeStatement ;
    dmn:clause "6.2.2.3"@en ;
    dmn:page "25" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "They may be drawn from Input Data and Decisions to Knowledge Sources, where, in conjunction with use (a), they represent the derivation of Business Knowledge Models from instances of Input Data and Decision results, using analytics."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "'They' = Authority Requirements, use b). Permissive wording; read with Table 2."@en ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-008 a dmn:NormativeStatement ;
    dmn:clause "6.2.3"@en ;
    dmn:page "26" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Note that no requirements may be drawn terminating in Input Data, that is, input data may have no requirements."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-009 a dmn:NormativeStatement ;
    dmn:clause "6.2.3"@en ;
    dmn:page "26" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Note also that the type of the requirement is uniquely determined by the types of the two elements connected."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Holds for Table 2 but not for DMN16.xsd/DMN16.xmi, which accept Decision -> Decision and Input Data -> Decision as AuthorityRequirement too."@en ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-010 a dmn:NormativeStatement ;
    dmn:clause "6.2.5"@en ;
    dmn:page "28" ;
    dmn:topic "decisionService" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The border SHALL enclose all the encapsulated decisions, and no other decisions or input data."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "DRD notation (checkable against DMNDI bounds)."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-011 a dmn:NormativeStatement ;
    dmn:clause "6.2.5"@en ;
    dmn:page "28" ;
    dmn:topic "decisionService" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If the set of output decisions is smaller than the set of encapsulated decisions, the Decision Service SHALL be divided into two parts with a straight solid line."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "DRD notation."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-012 a dmn:NormativeStatement ;
    dmn:clause "6.2.5"@en ;
    dmn:page "28" ;
    dmn:topic "decisionService" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "One part SHALL enclose only the output decisions and the Decision Service's Name; the other part SHALL enclose all the encapsulated decisions which are not in the set of output decisions."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "DRD notation."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-013 a dmn:NormativeStatement ;
    dmn:clause "6.2.5"@en ;
    dmn:page "30" ;
    dmn:topic "decisionService" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The constraint imposed on the rendering of decision services within a DRD is that the same decision service MUST NOT be rendered both expanded and collapsed within the same DRD."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "DRD notation."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-014 a dmn:NormativeStatement ;
    dmn:clause "6.2.5"@en ;
    dmn:page "30" ;
    dmn:topic "drg" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "This stems from the general restriction disallowing the same DMN Element to be present twice in the same diagram."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "DRD notation."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-015 a dmn:NormativeStatement ;
    dmn:clause "6.3.1"@en ;
    dmn:page "31" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The id of a DMNElement is further restricted to the syntax of an XML ID (https://www.w3.org/TR/2004/REC-xmlschema-2-20041028/datatypes.html#ID), and SHALL be unique within the decision model."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "In RDF an id is an IRI, so two elements with one id become one resource. The converter (scripts/dmn2rdf.py) reports a duplicate id before that happens."@en .

dmn:statement-016 a dmn:NormativeStatement ;
    dmn:clause "6.3.1 (Table 3)"@en ;
    dmn:page "31" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Optional identifier for this element. SHALL be unique within its containing Definitions element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Scope differs from the sentence above ('within the decision model')."@en ;
    dmn:notCheckedBecause "In RDF an id is an IRI, so two elements with one id become one resource. The converter (scripts/dmn2rdf.py) reports a duplicate id before that happens."@en .

dmn:statement-017 a dmn:NormativeStatement ;
    dmn:clause "6.3.2"@en ;
    dmn:page "33" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The language SHALL be specified in a URI format."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Definitions.expressionLanguage (6.3.2, also Table 5 for expressionLanguage and typeLanguage)."@en ;
    dmn:notCheckedBecause "The value is text in the metamodel; a URI check would repeat what xsd:anyURI in the schema already says."@en .

dmn:statement-018 a dmn:NormativeStatement ;
    dmn:clause "6.3.2"@en ;
    dmn:page "34" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The typeLanguage SHALL be specified in a URI format (the URI for FEEL is “https://www.omg.org/spec/DMN/20230324/FEEL/”;"@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "The FEEL URI given here (20230324) differs from the one given for expressionLanguage on the previous page (https://www.omg.org/spec/DMN/20240513/FEEL/)."@en ;
    dmn:notCheckedBecause "The value is text in the metamodel; a URI check would repeat what xsd:anyURI in the schema already says."@en .

dmn:statement-019 a dmn:NormativeStatement ;
    dmn:clause "6.3.3"@en ;
    dmn:page "35" ;
    dmn:topic "import" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Imports SHALL be explicitly defined."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-020 a dmn:NormativeStatement ;
    dmn:clause "6.3.3"@en ;
    dmn:page "35" ;
    dmn:topic "import" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The namespace value should be globally unique, but the import name, which is typically a short business-friendly name, must be distinct from the names of other imports, decisions, input data, business knowledge models, decision services, and item definitions within the importing model only."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-021 a dmn:NormativeStatement ;
    dmn:clause "6.3.4"@en ;
    dmn:page "36" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The id of an ElementCollection element SHALL be unique within the containing instance of Definitions."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "In RDF an id is an IRI, so two elements with one id become one resource. The converter (scripts/dmn2rdf.py) reports a duplicate id before that happens."@en .

dmn:statement-022 a dmn:NormativeStatement ;
    dmn:clause "6.3.4"@en ;
    dmn:page "36" ;
    dmn:topic "drg" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Notice that an ElementCollection element must reference the instances of DRGElement that it collects, not contain them: instances of DRGElement can only be contained in Definitions elements."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Holds by construction: the metamodel (dmn.ttl) offers no other place for it, and the converter reports anything it cannot place."@en .

dmn:statement-023 a dmn:NormativeStatement ;
    dmn:clause "6.3.5"@en ;
    dmn:page "36" ;
    dmn:topic "drg" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "All the elements of a DMN decision model that are not contained directly in a Definitions element (specifically: all three kinds of requirement, bindings, clause and decision rules, import, and objective) SHALL be contained in an instance of DRGElement, or in a model element that is contained in an instance of DRGElement, recursively."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Lists 'import' although Definitions contains import directly (6.3.2, Table 5)."@en ;
    dmn:notCheckedBecause "Holds by construction: the metamodel (dmn.ttl) offers no other place for it, and the converter reports anything it cannot place."@en .

dmn:statement-024 a dmn:NormativeStatement ;
    dmn:clause "6.3.5"@en ;
    dmn:page "36" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The id of a DRGElement element SHALL be unique within the containing instance of Definitions."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "In RDF an id is an IRI, so two elements with one id become one resource. The converter (scripts/dmn2rdf.py) reports a duplicate id before that happens."@en .

dmn:statement-025 a dmn:NormativeStatement ;
    dmn:clause "6.3.6.2"@en ;
    dmn:page "37" ;
    dmn:topic "drg" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "As an Artifact, a Group is not a DRGElement, and, therefore, cannot be connected to/from an Information Requirement, Knowledge Requirement, or Authority Requirement."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:InformationRequirementShape ;
    dmn:checkedBy dmnsh:KnowledgeRequirementShape ;
    dmn:checkedBy dmnsh:AuthorityRequirementShape .

dmn:statement-026 a dmn:NormativeStatement ;
    dmn:clause "6.3.6.2"@en ;
    dmn:page "37" ;
    dmn:topic "drg" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "It can only be connected to/from an Association."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "'It' = a Group."@en ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-027 a dmn:NormativeStatement ;
    dmn:clause "6.3.7"@en ;
    dmn:page "38" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The name of a Decision must be different from the name of any other invocable, input data, decision, or import in the decision model."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueNameShape .

dmn:statement-028 a dmn:NormativeStatement ;
    dmn:clause "6.3.7"@en ;
    dmn:page "39" ;
    dmn:topic "decision" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An instance of Decision – that is, the model of a decision – is said to be well-formed if and only if all of its informationRequirement and knowledgeRequirement elements are well-formed"@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:InformationAcyclicShape .

dmn:statement-029 a dmn:NormativeStatement ;
    dmn:clause "6.3.7"@en ;
    dmn:page "39" ;
    dmn:topic "decision" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "That condition entails, in particular, that the requirement subgraph of a Decision element SHALL be acyclic, that is, that a Decision element SHALL not require itself, directly or indirectly."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:InformationAcyclicShape ;
    dmn:checkedBy dmnsh:KnowledgeAcyclicShape .

dmn:statement-030 a dmn:NormativeStatement ;
    dmn:clause "6.3.9"@en ;
    dmn:page "42" ;
    dmn:topic "bkm" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A business knowledge model has an abstract part, representing reusable, invocable decision logic, and a concrete part, which mandates that the decision logic must be a single FEEL boxed function definition."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "A definition, used by the computed checks."@en .

dmn:statement-031 a dmn:NormativeStatement ;
    dmn:clause "6.3.9"@en ;
    dmn:page "42" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The name of an Invocable must be different from the name of any other invocable, input data, decision, or import in the decision model."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueNameShape .

dmn:statement-032 a dmn:NormativeStatement ;
    dmn:clause "6.3.9"@en ;
    dmn:page "42" ;
    dmn:topic "bkm" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "That condition entails, in particular, that the requirement subgraph of a BusinessKnowledgeModel element SHALL be acyclic, that is, that a BusinessKnowledgeModel element SHALL not require itself, directly or indirectly."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:KnowledgeAcyclicShape .

dmn:statement-033 a dmn:NormativeStatement ;
    dmn:clause "6.3.9"@en ;
    dmn:page "42" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The name of that InformationItem SHALL be the same as the name of the Invocable element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "The variable of an Invocable (BKM or Decision Service)."@en ;
    dmn:checkedBy dmnsh:VariableNameShape .

dmn:statement-034 a dmn:NormativeStatement ;
    dmn:clause "6.3.10"@en ;
    dmn:page "43" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The id of a DecisionService element SHALL be unique within the containing instance of Definitions."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "In RDF an id is an IRI, so two elements with one id become one resource. The converter (scripts/dmn2rdf.py) reports a duplicate id before that happens."@en .

dmn:statement-035 a dmn:NormativeStatement ;
    dmn:clause "6.3.10"@en ;
    dmn:page "44" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The name of the variable and the name of the DecisionService SHALL be the same."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:VariableNameShape .

dmn:statement-036 a dmn:NormativeStatement ;
    dmn:clause "6.3.10"@en ;
    dmn:page "44" ;
    dmn:topic "decisionService" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A DecisionService element has one or more associated outputDecisions, which are the instances of Decision required to be output by this DecisionService, i.e., the Decisions whose results the Decision Service must return when called."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Table 17 says outputDecisions [1..*]; DMN16.xsd (outputDecision minOccurs=0) and DMN16.xmi (outputDecision [0..*]) do not enforce it."@en ;
    dmn:checkedBy dmnsh:DecisionServiceOutputShape .

dmn:statement-037 a dmn:NormativeStatement ;
    dmn:clause "6.3.10"@en ;
    dmn:page "44" ;
    dmn:topic "decisionService" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "At least one of the encapsulatedDecisions and inputDecisions attributes SHALL be specified."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:DecisionServiceContentShape .

dmn:statement-038 a dmn:NormativeStatement ;
    dmn:clause "6.3.10"@en ;
    dmn:page "44" ;
    dmn:topic "decisionService" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An instance of DecisionService is said to be well-formed if and only if its requirement subgraph is acyclic, that is, that a DecisionService element SHALL not require itself, directly or indirectly."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-039 a dmn:NormativeStatement ;
    dmn:clause "6.3.11"@en ;
    dmn:page "45" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The name of an InputData must be different from the name of any other decision, input data, business knowledge model, decision service, or import in the decision model."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueNameShape .

dmn:statement-040 a dmn:NormativeStatement ;
    dmn:clause "6.3.11"@en ;
    dmn:page "45" ;
    dmn:topic "inputData" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An InputData element does not have a requirement subgraph, and it is always well-formed."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Holds by construction: the metamodel (dmn.ttl) offers no other place for it, and the converter reports anything it cannot place."@en .

dmn:statement-041 a dmn:NormativeStatement ;
    dmn:clause "6.3.12 (Table 19)"@en ;
    dmn:page "46" ;
    dmn:topic "knowledgeSource" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The locationURI SHALL be specified in a URI format."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "The value is text in the metamodel; a URI check would repeat what xsd:anyURI in the schema already says."@en .

dmn:statement-042 a dmn:NormativeStatement ;
    dmn:clause "6.3.13"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An InformationRequirement element is a component of a Decision element, and it associates that requiring Decision element with a requiredDecision element, which is an instance of Decision, or a requiredInput element, which is an instance of InputData."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:InformationRequirementShape .

dmn:statement-043 a dmn:NormativeStatement ;
    dmn:clause "6.3.13"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Notice that an InformationRequirement element must reference the instance of Decision or InputData that it associates with the requiring Decision element, not contain it: instances of Decision or InputData can only be contained in Definitions elements."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:InformationRequirementShape .

dmn:statement-044 a dmn:NormativeStatement ;
    dmn:clause "6.3.13"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "It references a requiredDecision or a requiredInput element, but not both."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Well-formedness condition of InformationRequirement."@en ;
    dmn:checkedBy dmnsh:InformationRequirementShape .

dmn:statement-045 a dmn:NormativeStatement ;
    dmn:clause "6.3.13"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The referenced requiredDecision or requiredInput element is well-formed."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Well-formedness condition of InformationRequirement."@en ;
    dmn:checkedBy dmnsh:InformationRequirementShape .

dmn:statement-046 a dmn:NormativeStatement ;
    dmn:clause "6.3.13"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The Decision element that contains the instance of InformationRequirement is not in the requirement subgraph of the referenced requiredknowledge element, if this InformationRequirement element references one."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Well-formedness condition of InformationRequirement. Says 'requiredknowledge', a property InformationRequirement does not have (copy from 6.3.14); presumably requiredDecision is meant."@en ;
    dmn:checkedBy dmnsh:InformationAcyclicShape .

dmn:statement-047 a dmn:NormativeStatement ;
    dmn:clause "6.3.13"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The referenced requiredDecision or requiredInput element is defined in the same decision model or in an imported decision model."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Well-formedness condition of InformationRequirement."@en ;
    dmn:checkedBy dmnsh:InformationRequirementShape .

dmn:statement-048 a dmn:NormativeStatement ;
    dmn:clause "6.3.14"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A KnowledgeRequirement element is a component of a Decision element or of a BusinessKnowledgeModel element, and it associates that requiring Decision or BusinessKnowledgeModel element with a requiredKnowledge element, which is an instance of Invocable."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:KnowledgeRequirementShape ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-049 a dmn:NormativeStatement ;
    dmn:clause "6.3.14"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Notice that a KnowledgeRequirement element must reference the instance of Invocable that it associates with the requiring Decision or BusinessKnowledgeModel element, not contain it: instances of BusinessKnowledgeModel can only be contained in Definitions elements."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:KnowledgeRequirementShape .

dmn:statement-050 a dmn:NormativeStatement ;
    dmn:clause "6.3.14"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "It references a requiredKnowledge element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Well-formedness condition of KnowledgeRequirement."@en ;
    dmn:checkedBy dmnsh:KnowledgeRequirementShape .

dmn:statement-051 a dmn:NormativeStatement ;
    dmn:clause "6.3.14"@en ;
    dmn:page "47" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The referenced requiredKnowledge element is well-formed."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Well-formedness condition of KnowledgeRequirement."@en ;
    dmn:checkedBy dmnsh:KnowledgeRequirementShape .

dmn:statement-052 a dmn:NormativeStatement ;
    dmn:clause "6.3.14"@en ;
    dmn:page "48" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If the KnowledgeRequirement element is contained in an instance of BusinessKnowledgeModel, that BusinessKnowledgeModel element is not in the requirement subgraph of the referenced requiredKnowledge element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Well-formedness condition of KnowledgeRequirement."@en ;
    dmn:checkedBy dmnsh:KnowledgeAcyclicShape .

dmn:statement-053 a dmn:NormativeStatement ;
    dmn:clause "6.3.14"@en ;
    dmn:page "48" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The referenced requiredKnowledge element is defined in the same decision model or in an imported decision model."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Well-formedness condition of KnowledgeRequirement."@en ;
    dmn:checkedBy dmnsh:KnowledgeRequirementShape .

dmn:statement-054 a dmn:NormativeStatement ;
    dmn:clause "6.3.15"@en ;
    dmn:page "48" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An AuthorityRequirement element is a component of a Decision, BusinessKnowledgeModel or KnowledgeSource element, and it associates that requiring Decision, BusinessKnowledgeModel or KnowledgeSource element with a requiredAuthority element, which is an instance of KnowledgeSource, a requiredDecision element, which is an instance of Decision, or a requiredInput element, which is an instance of InputData."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Read alone this permits all 9 combinations, as the schema does; Table 22 and Table 2 restrict requiredDecision/requiredInput to a KnowledgeSource owner."@en ;
    dmn:checkedBy dmnsh:AuthorityRequirementShape ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-055 a dmn:NormativeStatement ;
    dmn:clause "6.3.15"@en ;
    dmn:page "48" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Notice that an AuthorityRequirement element must reference the instance of KnowledgeSource, Decision or InputData that it associates with the requiring element, not contain it: instances of Knowledge Source, Decision or InputData can only be contained in Definitions elements."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:AuthorityRequirementShape .

dmn:statement-056 a dmn:NormativeStatement ;
    dmn:clause "6.3.15 (Table 22, requiredDecision)"@en ;
    dmn:page "48" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The instance of Decision that this AuthorityRequirement associates with its containing KnowledgeSource element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Restricts AuthorityRequirement.requiredDecision to a KnowledgeSource owner; not enforced by DMN16.xsd/DMN16.xmi."@en ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-057 a dmn:NormativeStatement ;
    dmn:clause "6.3.15 (Table 22, requiredInput)"@en ;
    dmn:page "48" ;
    dmn:topic "requirements" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The instance of InputData that this AuthorityRequirement associates with its containing KnowledgeSource element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Restricts AuthorityRequirement.requiredInput to a KnowledgeSource owner; not enforced by DMN16.xsd/DMN16.xmi."@en ;
    dmn:checkedBy dmnsh:RequirementMatrixShape .

dmn:statement-058 a dmn:NormativeStatement ;
    dmn:clause "7.1"@en ;
    dmn:page "52" ;
    dmn:topic "decision" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each variable that is referenced by a decision’s expression must be associated with a required decision, required input data, or required knowledge."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-059 a dmn:NormativeStatement ;
    dmn:clause "7.1"@en ;
    dmn:page "52" ;
    dmn:topic "decision" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "Also, each variable associated with the required decisions, required input data, and required knowledge SHOULD be referenced in the decision’s expression."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-060 a dmn:NormativeStatement ;
    dmn:clause "7.1"@en ;
    dmn:page "52" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The input variables of a decision's decision logic must not be used outside that value expression or its component value expressions: the decision element defines the lexical scope of the input variables for its decision logic."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-061 a dmn:NormativeStatement ;
    dmn:clause "7.1"@en ;
    dmn:page "52" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "To avoid name collisions and ambiguity, the name of a variable must be unique within its scope."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-062 a dmn:NormativeStatement ;
    dmn:clause "7.1"@en ;
    dmn:page "52" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "When DRG elements are mapped to FEEL, the name of a variable is the same as the (possibly qualified) name of its associated input data or decision, which guarantees its uniqueness."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:VariableNameShape .

dmn:statement-063 a dmn:NormativeStatement ;
    dmn:clause "7.1"@en ;
    dmn:page "52" ;
    dmn:topic "bkm" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "If a business knowledge model element requires one or more other business knowledge models, it SHOULD have an explicit value expression that describes how the required business knowledge models are invoked and their results combined or otherwise elaborated."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-064 a dmn:NormativeStatement ;
    dmn:clause "7.2.1"@en ;
    dmn:page "53" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "This boxed expression SHALL have a name box that contains the name of the DRG artifact."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "The top-level boxed expression of a DRG element."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-065 a dmn:NormativeStatement ;
    dmn:clause "7.2.2.1"@en ;
    dmn:page "54" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "To avoid having to discern whether (e.g.,) HIGH, DECLINE is \"HIGH,\" \"DECLINE,\" or \"HIGH, DECLINE,\" typographical string literals SHALL be free of commas (\",\" characters)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-066 a dmn:NormativeStatement ;
    dmn:clause "7.2.2.1"@en ;
    dmn:page "54" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "FEEL typographical string literals SHALL conform to grammar rule 22 (name)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Rule 22 is 'name' in the S-FEEL grammar (9.2); in the FEEL grammar (10.3.1.2) 'name' is rule 25."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-067 a dmn:NormativeStatement ;
    dmn:clause "7.2.2.2"@en ;
    dmn:page "54" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The literal SHALL obey the syntax specified in clauses 10.3.2.3.4, 10.3.2.3.5, and 10.3.2.3.7."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Typographical date and time literals."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-068 a dmn:NormativeStatement ;
    dmn:clause "7.3.1"@en ;
    dmn:page "56" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An instance of Expression is a component of a Decision element, of a BusinessKnowledgeModel element, or of an ItemDefinition element, or it is a component of another instance of Expression, directly or indirectly."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Holds by construction: the metamodel (dmn.ttl) offers no other place for it, and the converter reports anything it cannot place."@en .

dmn:statement-069 a dmn:NormativeStatement ;
    dmn:clause "7.3.1"@en ;
    dmn:page "56" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If an instance of Expression that defines the output of a Decision element includes a typeRef, the referenced type SHALL be the same as the type of the containing Decision element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-070 a dmn:NormativeStatement ;
    dmn:clause "7.3.2"@en ;
    dmn:page "57" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An instance of UnaryTests inherits an optional typeRef from Expression, which SHALL NOT be used."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UnaryTestsTypeRefShape .

dmn:statement-071 a dmn:NormativeStatement ;
    dmn:clause "7.3.2; 7.3.5"@en ;
    dmn:page "57" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The expressionLanguage SHALL be specified in a URI format."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Same sentence for UnaryTests (7.3.2) and LiteralExpression (7.3.5)."@en ;
    dmn:notCheckedBecause "The value is text in the metamodel; a URI check would repeat what xsd:anyURI in the schema already says."@en .

dmn:statement-072 a dmn:NormativeStatement ;
    dmn:clause "7.3.2"@en ;
    dmn:page "57" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "When the expression language is FEEL, the text must conform to grammar rule 15 in section 10.3.1.2."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "UnaryTests.text."@en ;
    dmn:checkedBy dmnsh:NotDecided .

dmn:statement-073 a dmn:NormativeStatement ;
    dmn:clause "7.3.2 (Table 25); 7.3.5 (Table 29)"@en ;
    dmn:page "57" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "It SHALL be a valid expression in the expressionLanguage"@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "text of UnaryTests (Table 25) and of LiteralExpression (Table 29, where the extract reads 'express ionLanguage')."@en ;
    dmn:checkedBy dmnsh:NotDecided .

dmn:statement-074 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The name of an ItemDefinition element SHALL be distinct from the names of other ItemDefinitions and Imports within the same model."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-075 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "In the latter case, the external document SHALL be imported in the Definitions element that contains the instance of ItemDefinition, using an Import element specifying both the namespace value and its name when used a qualifier."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "'The latter case' = a typeRef to a type defined in an imported DMN, XSD or other document."@en ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-076 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A typeRef referencing a built-in type SHALL omit the prefix."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-077 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "In cases where the isCollection attribute of an ItemDefinition is true, each element of the collection must satisfy the UnaryTests of the allowedValues, i.e. the allowedValues are projected onto the collection elements."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-078 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "The allowedValues attribute has been deprecated as of DMN 1.5 and replaced with the typeConstraint attribute."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Deprecation; a warning, not an error."@en ;
    dmn:checkedBy dmnsh:AllowedValuesDeprecatedShape .

dmn:statement-079 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The name of an itemComponent (nested ItemDefinition) must be unique within its containing ItemDefinition or itemComponent."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-080 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An instance of ItemDefinition may contain at most one FunctionItem."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:ItemDefinitionShape .

dmn:statement-081 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A FunctionItem may contain zero or more parameters defined as InformationItems and one output type defined as a typeRef."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Table 27 makes outputTypeRef [0..1]."@en ;
    dmn:notCheckedBecause "Holds by construction: the metamodel (dmn.ttl) offers no other place for it, and the converter reports anything it cannot place."@en .

dmn:statement-082 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "58" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The names of the parameters of a FunctionItem are unique."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-083 a dmn:NormativeStatement ;
    dmn:clause "7.3.3"@en ;
    dmn:page "59" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An ItemDefinition element SHALL be defined using only one of the alternative ways:"@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "The three ways: reference to a built-in or imported typeRef (possibly restricted with allowedValues), composition of ItemDefinition elements, function signature element. The XSD enforces this with an xsd:choice."@en ;
    dmn:checkedBy dmnsh:ItemDefinitionShape .

dmn:statement-084 a dmn:NormativeStatement ;
    dmn:clause "7.3.4"@en ;
    dmn:page "60" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "InformationItem is a concrete subclass of NamedElement, from which it inherits the id, and optional name, description, and label attributes, except that an InformationItem element SHALL have a name attribute, which is the name that is used to represent it in other Expression elements."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:InformationItemNameShape .

dmn:statement-085 a dmn:NormativeStatement ;
    dmn:clause "7.3.4"@en ;
    dmn:page "60" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The name of an InformationItem element SHALL be unique within its scope."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-086 a dmn:NormativeStatement ;
    dmn:clause "7.3.4"@en ;
    dmn:page "60" ;
    dmn:topic "decision" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "A variable representing an instance of Decision or InputData referenced by aInformationRequirement SHOULD be referenced by the value expression of the decision logic in the Decision element that contains the InformationRequirement element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "'aInformationRequirement' as printed."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-087 a dmn:NormativeStatement ;
    dmn:clause "7.3.4"@en ;
    dmn:page "60" ;
    dmn:topic "bkm" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "A parameter in an instance of BusinessKnowledgeModel SHOULD be a variable in the value expression of that BusinessKnowledgeModel element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-088 a dmn:NormativeStatement ;
    dmn:clause "7.3.4"@en ;
    dmn:page "60" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "In any case, the datatype indicated by the typeRef that is associated with an instance of InformationItem SHALL be compatible with the datatype that is associated with the DMN model element from which it takes its value."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-089 a dmn:NormativeStatement ;
    dmn:clause "7.3.5"@en ;
    dmn:page "61" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An instance of LiteralExpression SHALL NOT have both a text and importedValues."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:LiteralExpressionShape .

dmn:statement-090 a dmn:NormativeStatement ;
    dmn:clause "7.3.5"@en ;
    dmn:page "61" ;
    dmn:topic "import" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The importType of the importedValues identifies the type of document containing the imported text and SHALL be consistent with the expressionLanguage of the LiteralExpression element."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-091 a dmn:NormativeStatement ;
    dmn:clause "7.3.5"@en ;
    dmn:page "61" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The semantics of DMN decision models as described in this specification applies only if the text of all the instances of LiteralExpression in the model are valid expressions in their associated expression language."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-092 a dmn:NormativeStatement ;
    dmn:clause "7.3.6"@en ;
    dmn:page "62" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An Invocation contains a calledFunction, an Expression, which must evaluate to a function."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Table 30 calledFunction [1] and XMI [1..1]; DMN16.xsd makes it optional (minOccurs=0)."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-093 a dmn:NormativeStatement ;
    dmn:clause "7.3.6"@en ;
    dmn:page "62" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The binding is by matching the InformationItem names."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-094 a dmn:NormativeStatement ;
    dmn:clause "7.3.6"@en ;
    dmn:page "62" ;
    dmn:topic "expression" ;
    dmn:strength "MAY" ;
    dmn:verbatim "Invocation MAY be used to model invocations in decision models, when a Decision element has exactly one knowledgeRequirement element, and when the decisionLogic in the Decision element consists only in invoking the BusinessKnowledgeModel element that is referenced by that requiredKnowledge and a more complex value expression is not required."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "A definition, used by the computed checks."@en .

dmn:statement-095 a dmn:NormativeStatement ;
    dmn:clause "7.3.6"@en ;
    dmn:page "62" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The calledFunction that is associated with the Invocation element SHALL BE the encapsultedLogic of the BusinessKnowledgeModel element that is required by the Decision element that contains the Invocation."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Ignores Decision Services as invocables (6.3.9, 6.2.2.2)."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-096 a dmn:NormativeStatement ;
    dmn:clause "7.3.6"@en ;
    dmn:page "62" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The Invocation element SHALL have exactly one binding for each parameter in the BusinessKnowledgeModel's encapsulatedLogic."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Stronger than 7.3.7 ('a subset of the formalParameters')."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-097 a dmn:NormativeStatement ;
    dmn:clause "7.3.7"@en ;
    dmn:page "62" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A Binding is made of one bindingFormula, which is an Expression, and of one parameter, which is an InformationItem."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Table 31 and DMN16.xsd make bindingFormula [0..1]."@en ;
    dmn:notCheckedBecause "Holds by construction: the metamodel (dmn.ttl) offers no other place for it, and the converter reports anything it cannot place."@en .

dmn:statement-098 a dmn:NormativeStatement ;
    dmn:clause "7.3.7"@en ;
    dmn:page "63" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The parameter names in the Binding elements SHALL be a subset of the formalParameters of the calledFunction."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-099 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "65" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "Moreover, a complete table contains all possible combinations of input values (all the rules)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:Gap .

dmn:statement-100 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "65" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A single output clause has no name."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:SingleOutputNameShape .

dmn:statement-101 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "65" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each of the multiple output clauses SHALL be named."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:OutputNameShape .

dmn:statement-102 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "65" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each output component SHALL be named."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:OutputNameShape .

dmn:statement-103 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "65" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each output (component) SHALL specify an output entry for each rule."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:EntryCountShape .

dmn:statement-104 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "65" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each annotation SHALL be named as part of a rule annotation clause."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:AnnotationClauseNameShape .

dmn:statement-105 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "65" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A list of output clauses (one or more)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:DecisionTableOutputShape .

dmn:statement-106 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "65" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A list of rules (one or more) in rows or columns of the table (depending on orientation), where each rule is composed of the specific input entries, output entries and optional rule annotations of the table row (or column)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Table 32 (rule [*]) and DMN16.xsd (rule minOccurs=0) allow a table without rules."@en ;
    dmn:checkedBy dmnsh:DecisionTableRulesShape .

dmn:statement-107 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "68" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "If two input entries of the same input expression share no values, the entries (cells) are called disjoint."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueOverlap .

dmn:statement-108 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "68" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "‘Irrelevant’ (‘-’) overlaps with any input entry of the input expression."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueOverlap .

dmn:statement-109 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "68" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "Two rules are overlapping if all corresponding input entries are overlapping."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueOverlap ;
    dmn:checkedBy dmnsh:AnyConflict .

dmn:statement-110 a dmn:NormativeStatement ;
    dmn:clause "8.1"@en ;
    dmn:page "68" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "Two rules are disjoint (non-overlapping) if at least one pair of corresponding input expressions is disjoint."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueOverlap .

dmn:statement-111 a dmn:NormativeStatement ;
    dmn:clause "8.2"@en ;
    dmn:page "68" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Rule numbering is required for tables with hit indicator F (first) or R (rule order) because the meaning depends on rule sequence."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Holds by construction: the converter keeps the order of rules as dmn:position (1-based)."@en .

dmn:statement-112 a dmn:NormativeStatement ;
    dmn:clause "8.2"@en ;
    dmn:page "68" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Crosstab tables have no rule numbers."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-113 a dmn:NormativeStatement ;
    dmn:clause "8.2.2"@en ;
    dmn:page "68" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Crosstab tables can only have the default hit policy (see later)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:CrosstabShape .

dmn:statement-114 a dmn:NormativeStatement ;
    dmn:clause "8.2.2"@en ;
    dmn:page "69" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "Decision table inputs and outputs should not be mixed."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-115 a dmn:NormativeStatement ;
    dmn:clause "8.2.2"@en ;
    dmn:page "69" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "In a horizontal table, all input columns SHALL be represented on the left of all output columns."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Notation."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-116 a dmn:NormativeStatement ;
    dmn:clause "8.2.2"@en ;
    dmn:page "69" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "In a vertical table, all the input rows SHALL be represented above all output rows."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Notation."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-117 a dmn:NormativeStatement ;
    dmn:clause "8.2.2"@en ;
    dmn:page "69" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "In a crosstab, all the output cells SHALL be in the bottom-right part of the table."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Notation."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-118 a dmn:NormativeStatement ;
    dmn:clause "8.2.4"@en ;
    dmn:page "70" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "a decision table will be considered complete if its rules cover all combinations of expected input values for all input expressions."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:Gap .

dmn:statement-119 a dmn:NormativeStatement ;
    dmn:clause "8.2.4"@en ;
    dmn:page "70" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "Regardless of how the expected input values are modeled, input values SHOULD be exclusive and complete."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-120 a dmn:NormativeStatement ;
    dmn:clause "8.2.4"@en ;
    dmn:page "70" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "Exclusive means that input values are disjoint."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "A definition, used by the computed checks."@en .

dmn:statement-121 a dmn:NormativeStatement ;
    dmn:clause "8.2.4"@en ;
    dmn:page "70" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "Complete means that all relevant input values from the domain are present."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "A definition, used by the computed checks."@en .

dmn:statement-122 a dmn:NormativeStatement ;
    dmn:clause "8.2.4"@en ;
    dmn:page "71" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The list of input values is optional. If provided, it is a list of unary tests that must be satisfied by the corresponding input."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:EntryOutsideInputValues .

dmn:statement-123 a dmn:NormativeStatement ;
    dmn:clause "8.2.5"@en ;
    dmn:page "71" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A decision table with multiple output components SHALL specify a name for each output component."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:OutputNameShape .

dmn:statement-124 a dmn:NormativeStatement ;
    dmn:clause "8.2.5"@en ;
    dmn:page "71" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A decision table that is the value expression of an InformationItem (e.g., a Decision's logic or a boxed Invocation's binding formula) SHALL specify the name of the InformationItem as its Information Item name."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-125 a dmn:NormativeStatement ;
    dmn:clause "8.2.6"@en ;
    dmn:page "71" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The list of output values is optional. If provided, it is a list restricting output entries to the given list of values."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:OutputOutsideOutputValues .

dmn:statement-126 a dmn:NormativeStatement ;
    dmn:clause "8.2.6"@en ;
    dmn:page "71" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "When the hit policy is P (priority), meaning that multiple rules can match, but only one hit should be returned, the ordering of the list of output values is used to specify the (decreasing) priority."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:OutputValuesNeededShape .

dmn:statement-127 a dmn:NormativeStatement ;
    dmn:clause "8.2.6"@en ;
    dmn:page "71" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The ordering of the list of output values is also used when the hit policy is output order."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:OutputValuesNeededShape .

dmn:statement-128 a dmn:NormativeStatement ;
    dmn:clause "8.2.8"@en ;
    dmn:page "72" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Rule input entries are unary tests (grammar rule 15)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:NotDecided .

dmn:statement-129 a dmn:NormativeStatement ;
    dmn:clause "8.2.8"@en ;
    dmn:page "72" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "The input entries in a unary test SHOULD be ‘-’ or a subset of the input values specified."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:EntryOutsideInputValues .

dmn:statement-130 a dmn:NormativeStatement ;
    dmn:clause "8.2.8"@en ;
    dmn:page "72" ;
    dmn:topic "expression" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "This means that evaluating an expression or executing a rule should not change the evaluation of other expressions or rules of the same table."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-131 a dmn:NormativeStatement ;
    dmn:clause "8.2.10"@en ;
    dmn:page "73" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Rule output cells cannot be merged (except in crosstabs, where adjacent output cells with the same content can be merged)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Also in 8.2.9."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-132 a dmn:NormativeStatement ;
    dmn:clause "8.2.10.1"@en ;
    dmn:page "73" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Because there can be only one output entry for an output name, every rule must indicate no more than one ‘X’."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Shorthand notation in vertical tables."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-133 a dmn:NormativeStatement ;
    dmn:clause "8.2.10.1"@en ;
    dmn:page "73" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The other output entries must contain ‘-’."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Shorthand notation in vertical tables."@en ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-134 a dmn:NormativeStatement ;
    dmn:clause "8.2.10.1"@en ;
    dmn:page "73" ;
    dmn:topic "naming" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If an information item name is provided, and there is only one output name (which has to be equal to the information item name), the output name is optional."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-135 a dmn:NormativeStatement ;
    dmn:clause "8.2.11"@en ;
    dmn:page "73" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If rules overlap, meaning that more than one rule may match a given set of input values, the hit policy indicator is required in order to recognize the table type and unambiguously understand the decision logic."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueOverlap .

dmn:statement-136 a dmn:NormativeStatement ;
    dmn:clause "8.2.11"@en ;
    dmn:page "74" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Crosstab tables are always Unique and need no indicator."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:CrosstabShape .

dmn:statement-137 a dmn:NormativeStatement ;
    dmn:clause "8.2.11"@en ;
    dmn:page "74" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The hit policy SHALL default to Unique, in which case the hit indicator is optional."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueOverlap .

dmn:statement-138 a dmn:NormativeStatement ;
    dmn:clause "8.2.11"@en ;
    dmn:page "74" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Decision tables with the Unique hit policy SHALL NOT contain overlapping rules."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueOverlap .

dmn:statement-139 a dmn:NormativeStatement ;
    dmn:clause "8.2.11"@en ;
    dmn:page "74" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "the table type SHALL be clear and therefore the hit policy indication is mandatory, except for the default unique tables."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Model part of a sentence that starts with tool conformance ('Tools may support only a nonempty subset of hit policies, but ...')."@en ;
    dmn:checkedBy dmnsh:UniqueOverlap .

dmn:statement-140 a dmn:NormativeStatement ;
    dmn:clause "8.2.11.1"@en ;
    dmn:page "74" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A single hit table shall return the output of one rule only; a multiple hit table may return the output of multiple rules (or a function of the outputs, e.g., sum of values)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "A definition, used by the computed checks."@en .

dmn:statement-141 a dmn:NormativeStatement ;
    dmn:clause "8.2.11.1"@en ;
    dmn:page "74" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If the output entries are non-equal (ignoring rule annotations), the hit policy is incorrect, and the result is undefined."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Any hit policy: overlapping rules must have equal output entries."@en ;
    dmn:checkedBy dmnsh:AnyConflict .

dmn:statement-142 a dmn:NormativeStatement ;
    dmn:clause "8.2.11.1"@en ;
    dmn:page "75" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Decision tables with compound outputs support only the following hit policies: Unique, Any, Priority, First, Output order, Rule order and Collect without operator, because the collect operator is undefined over multiple outputs."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Contradicted by 10.3.2.10 (printed page 120), which omits Output order."@en ;
    dmn:checkedBy dmnsh:AggregationShape ;
    dmn:checkedBy dmnsh:CompoundHitPolicyShape .

dmn:statement-143 a dmn:NormativeStatement ;
    dmn:clause "8.2.11.1"@en ;
    dmn:page "75" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "For the Priority and Output order hit policies, priority is decided in compound output tables over all the outputs for which output values have been provided (ignoring rule annotations)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "A definition, used by the computed checks."@en .

dmn:statement-144 a dmn:NormativeStatement ;
    dmn:clause "8.2.11.1 (Note 1)"@en ;
    dmn:page "75" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Crosstab tables are unique and complete by definition and therefore do not need a hit policy."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:CrosstabShape .

dmn:statement-145 a dmn:NormativeStatement ;
    dmn:clause "8.2.11.1 (Note 2)"@en ;
    dmn:page "75" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "The sequence of the rules in a decision table does not influence the meaning, except in First tables (single hit) and Rule order tables (multiple hit)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:MaskedRule .

dmn:statement-146 a dmn:NormativeStatement ;
    dmn:clause "8.3.1"@en ;
    dmn:page "76" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "It has a preferredOrientation, which SHALL be one of the enumerated DecisionTableOrientation: Rule-as-Row, Rule-as-Column or CrossTable."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Holds by construction: the converter maps the value to an individual of dmn:DecisionTableOrientation (owl:oneOf) and reports any other value."@en .

dmn:statement-147 a dmn:NormativeStatement ;
    dmn:clause "8.3.1"@en ;
    dmn:page "76" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHOULD" ;
    dmn:verbatim "An instance of DecisionTable SHOULD BE represented as specified by its preferredOrientation, as defined in clause 8.2.2."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Notation of the diagram (DRD); diagram interchange is left out on purpose, so the RDF form holds no layout to check."@en .

dmn:statement-148 a dmn:NormativeStatement ;
    dmn:clause "8.3.1"@en ;
    dmn:page "76" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "An instance of DecisionTable has an associated hitPolicy, which SHALL be one of the enumerated HitPolicy: UNIQUE, FIRST, PRIORITY, ANY, COLLECT, RULE ORDER, OUTPUT ORDER."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Holds by construction: the converter maps the value to an individual of dmn:HitPolicy (owl:oneOf) and reports any other value."@en .

dmn:statement-149 a dmn:NormativeStatement ;
    dmn:clause "8.3.1"@en ;
    dmn:page "76" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The default value for the hitPolicy attribute is: UNIQUE."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:UniqueOverlap .

dmn:statement-150 a dmn:NormativeStatement ;
    dmn:clause "8.3.1"@en ;
    dmn:page "77" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If the hitPolicy associated with an instance of DecisionTable is FIRST or RULE ORDER, the rules that are associated with the DecisionTable SHALL be ordered."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Holds by construction: the converter keeps the order of rules as dmn:position (1-based)."@en .

dmn:statement-151 a dmn:NormativeStatement ;
    dmn:clause "8.3.1"@en ;
    dmn:page "77" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If the hitPolicy associated with an instance of DecisionTable is PRIORITY or OUTPUT ORDER, the outputValues determine the result as specified in clause 8.2.11."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "The extract reads 'outputValue s'."@en ;
    dmn:checkedBy dmnsh:OutputValuesNeededShape .

dmn:statement-152 a dmn:NormativeStatement ;
    dmn:clause "8.3.1"@en ;
    dmn:page "77" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If the hitPolicy that is associated with an instance of DecisionTable is COLLECT, the DecisionTable MAY have an associated aggregation, which is one of the enumerated BuiltinAggregator (see clause 8.2.11)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Implies: aggregation only with COLLECT."@en ;
    dmn:checkedBy dmnsh:AggregationShape .

dmn:statement-153 a dmn:NormativeStatement ;
    dmn:clause "8.3.1 (Table 32)"@en ;
    dmn:page "77" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If present, this attribute specifies the aggregation function to be applied to the unordered set of values of the applicable rules to determine the value of this DecisionTable when the hitPolicy is COLLECT."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "DecisionTable.aggregation."@en ;
    dmn:checkedBy dmnsh:AggregationShape .

dmn:statement-154 a dmn:NormativeStatement ;
    dmn:clause "8.3.2"@en ;
    dmn:page "78" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "When a DecisionTable contains more than one OutputClause, each OutputClause SHALL have a name."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:OutputNameShape .

dmn:statement-155 a dmn:NormativeStatement ;
    dmn:clause "8.3.2"@en ;
    dmn:page "78" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "When a DecisionTable has a single OutputClause, the OutputClause SHALL NOT have a name."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:SingleOutputNameShape .

dmn:statement-156 a dmn:NormativeStatement ;
    dmn:clause "8.3.2"@en ;
    dmn:page "78" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A RuleAnnotationClause SHALL have a name."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:AnnotationClauseNameShape .

dmn:statement-157 a dmn:NormativeStatement ;
    dmn:clause "8.3.2 (Table 34)"@en ;
    dmn:page "78" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The OutputClause of a single output decision table SHALL NOT specify a typeRef."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Same table row gives the multiplicity typeRef: String [1]."@en ;
    dmn:checkedBy dmnsh:SingleOutputNameShape .

dmn:statement-158 a dmn:NormativeStatement ;
    dmn:clause "8.3.3"@en ;
    dmn:page "79" ;
    dmn:topic "decisionTable" ;
    dmn:strength "DEFINITION" ;
    dmn:verbatim "By definition, a DecisionRule element that has no inputEntrys is always applicable."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:EntryCountShape .

dmn:statement-159 a dmn:NormativeStatement ;
    dmn:clause "8.3.3"@en ;
    dmn:page "79" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The inputEntry elements SHALL be in the same order as the containing DecisionTable's inputs."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:EntryCountShape .

dmn:statement-160 a dmn:NormativeStatement ;
    dmn:clause "8.3.3"@en ;
    dmn:page "79" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The outputEntry elements SHALL be in the same order as the containing DecisionTable's outputs."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:EntryCountShape .

dmn:statement-161 a dmn:NormativeStatement ;
    dmn:clause "8.3.3"@en ;
    dmn:page "79" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The ith outputEntry SHALL be consistent with the typeRef of the ith OutputClause."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-162 a dmn:NormativeStatement ;
    dmn:clause "8.3.3"@en ;
    dmn:page "79" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The ruleAnnotation elements SHALL be in the same order as the containing DecisionTable's annotations."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:notCheckedBecause "Not checked yet."@en .

dmn:statement-163 a dmn:NormativeStatement ;
    dmn:clause "9.5.1"@en ;
    dmn:page "86" ;
    dmn:topic "itemDefinition" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The expression that defines an allowed value SHALL be an instance of simple unary tests (grammar rule 12), where only the values in the defined or referenced type that satisfy the test are allowed values."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Applies when the expression language is S-FEEL (9.5)."@en ;
    dmn:checkedBy dmnsh:NotDecided .

dmn:statement-164 a dmn:NormativeStatement ;
    dmn:clause "9.5.2"@en ;
    dmn:page "86" ;
    dmn:topic "expression" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "In the bindings of an invocation, the binding formula SHALL be a simple expression (grammar rule 3)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Applies when the expression language is S-FEEL (9.5)."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-165 a dmn:NormativeStatement ;
    dmn:clause "9.5.3"@en ;
    dmn:page "86" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each input expression SHALL be a simple expression (grammar rule 3)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Applies when the expression language is S-FEEL (9.5)."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-166 a dmn:NormativeStatement ;
    dmn:clause "9.5.3"@en ;
    dmn:page "86" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each list of input values SHALL be an instance of simple unary tests (grammar rule 12)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Applies when the expression language is S-FEEL (9.5)."@en ;
    dmn:checkedBy dmnsh:NotDecided .

dmn:statement-167 a dmn:NormativeStatement ;
    dmn:clause "9.5.3"@en ;
    dmn:page "87" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each list of output values SHALL be an instance of simple unary tests (grammar rule 12)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Applies when the expression language is S-FEEL (9.5)."@en ;
    dmn:checkedBy dmnsh:NotDecided .

dmn:statement-168 a dmn:NormativeStatement ;
    dmn:clause "9.5.3"@en ;
    dmn:page "87" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each input entry SHALL be an instance of simple unary tests (grammar rule 12)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Applies when the expression language is S-FEEL (9.5)."@en ;
    dmn:checkedBy dmnsh:NotDecided .

dmn:statement-169 a dmn:NormativeStatement ;
    dmn:clause "9.5.3"@en ;
    dmn:page "87" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each output entry SHALL be a simple expression (grammar rule 3)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Applies when the expression language is S-FEEL (9.5)."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-170 a dmn:NormativeStatement ;
    dmn:clause "10.3.2.10"@en ;
    dmn:page "118" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each input expression SHALL be a textual expression (grammar rule 2)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "FEEL counterpart of 9.5.3."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-171 a dmn:NormativeStatement ;
    dmn:clause "10.3.2.10"@en ;
    dmn:page "118" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each list of input values SHALL be an instance of unary tests (grammar rule 15)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "FEEL counterpart of 9.5.3."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-172 a dmn:NormativeStatement ;
    dmn:clause "10.3.2.10"@en ;
    dmn:page "118" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each list of output values SHALL be an instance of unary tests (grammar rule 15)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "FEEL counterpart of 9.5.3."@en ;
    dmn:notCheckedBecause "Needs FEEL name resolution or a full FEEL parser; the checker decides S-FEEL cells only, and dmnsh:NotDecided reports the rest."@en .

dmn:statement-173 a dmn:NormativeStatement ;
    dmn:clause "10.3.2.10"@en ;
    dmn:page "118" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "Each input entry SHALL be an instance of unary tests (grammar rule 15)."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "FEEL counterpart of 9.5.3."@en ;
    dmn:checkedBy dmnsh:NotDecided .

dmn:statement-174 a dmn:NormativeStatement ;
    dmn:clause "10.3.2.10 (Table 46)"@en ;
    dmn:page "119" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "The default output value is one of the output values."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:DefaultOutputValue .

dmn:statement-175 a dmn:NormativeStatement ;
    dmn:clause "10.3.2.10"@en ;
    dmn:page "120" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "To reduce complexity, decision tables with compound outputs do not support aggregation and support only the following hit policies: Unique, Any, Priority, First, Collect without operator, and Rule order."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Omits Output order, which 8.2.11.1 allows for compound outputs."@en ;
    dmn:checkedBy dmnsh:AggregationShape ;
    dmn:checkedBy dmnsh:CompoundHitPolicyShape .

dmn:statement-176 a dmn:NormativeStatement ;
    dmn:clause "10.3.2.10"@en ;
    dmn:page "120" ;
    dmn:topic "decisionTable" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "A complete decision table SHALL NOT specify a default output value."@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    dmn:checkedBy dmnsh:DefaultOutputValue .

dmn:statement-177 a dmn:NormativeStatement ;
    dmn:clause "10.3.2.10"@en ;
    dmn:page "120" ;
    dmn:topic "hitPolicy" ;
    dmn:strength "SHALL" ;
    dmn:verbatim "If the hit policy is \"Output order\", the decision table SHALL be single output"@en ;
    dct:source <https://www.omg.org/spec/DMN/1.6/PDF> ;
    rdfs:comment "Contradicts 8.2.11.1 and Figure 8-19 ('Output order with compound output')."@en ;
    dmn:checkedBy dmnsh:CompoundHitPolicyShape .
